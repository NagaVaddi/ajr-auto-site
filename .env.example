# Server-side base URL (never NEXT_PUBLIC_ — keeps internal URL out of client bundle)
BASE_URL=http://localhost:3000

# For production (Vercel sets this automatically as VERCEL_URL, but set explicitly):
# BASE_URL=https://your-domain.ru

# --- Optional: real data sources (add when replacing mock API) ---

# PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/autobrand

# Avito Partner API
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
# AVITO_USER_ID=
